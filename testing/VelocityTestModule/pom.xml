<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>net.managerhub</groupId>
  <artifactId>center-velocitytestmodule</artifactId>
  <version>1.0.0-beta.1</version>
  <packaging>jar</packaging>

  <name>Center2 Velocity TestModule</name>
  <description>Center2 Velocity TestModule - proves that a proxy module is loaded and can register a command.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <center.version>1.0.0-beta.1</center.version>
    <velocity.api.version>3.5.0-SNAPSHOT</velocity.api.version>
    <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!--
      The Center2 module API. Center2 is already running when the module is
      loaded, so these classes must never be packed into the module jar.
      Build the core once with "mvn install" in ../../Center2.
    -->
    <dependency>
      <groupId>net.managerhub</groupId>
      <artifactId>center</artifactId>
      <version>${center.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      Provided by the proxy. A module only needs this to name a Velocity event;
      everything else it uses comes from the Center2 module API.
    -->
    <dependency>
      <groupId>com.velocitypowered</groupId>
      <artifactId>velocity-api</artifactId>
      <version>${velocity.api.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- The jar that is copied into plugins/Center2/Modules/Jars on the proxy. -->
    <finalName>Center2-VelocityTestModule-${project.version}</finalName>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
      </plugin>
    </plugins>
  </build>

</project>
