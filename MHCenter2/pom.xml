<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>net.managerhub</groupId>
  <artifactId>mhcenter2</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>MHCenter2</name>
  <description>MHCenter2 - shared server core for Paper and Velocity.</description>
  <url>https://managerhub.net</url>

  <organization>
    <name>Manager Hub</name>
    <url>https://managerhub.net</url>
  </organization>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <maven.compiler.release>25</maven.compiler.release>

    <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>
    <velocity.api.version>3.5.0-SNAPSHOT</velocity.api.version>
    <sqlite.jdbc.version>3.46.1.3</sqlite.jdbc.version>
    <mariadb.jdbc.version>3.5.6</mariadb.jdbc.version>
    <junit.version>5.11.4</junit.version>

    <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
    <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
    <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- Paper API: vom Server bereitgestellt, darf nicht in die JAR gelangen. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Velocity API: vom Proxy bereitgestellt, darf nicht in die JAR gelangen. -->
    <dependency>
      <groupId>com.velocitypowered</groupId>
      <artifactId>velocity-api</artifactId>
      <version>${velocity.api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      SQLite JDBC: einzige Laufzeitabhaengigkeit. Weder Paper noch Velocity liefern
      einen SQLite-Treiber mit, deshalb wird genau dieses Artefakt in die JAR
      gebuendelt (siehe maven-shade-plugin weiter unten).
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.jdbc.version}</version>
      <scope>compile</scope>
    </dependency>

    <!--
      MariaDB JDBC: nur noetig, wenn der Betreiber die optionale Remote-Datenbank
      einschaltet. Der Treiber wird wie SQLite in die JAR gebuendelt, weil weder
      Paper noch Velocity einen mitbringen. Ohne "remote.enabled: true" wird er
      nie geladen.
    -->
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <version>${mariadb.jdbc.version}</version>
      <scope>compile</scope>
    </dependency>

    <!-- Nur fuer Unit-Tests der plattformneutralen Logik. Nicht Teil der JAR. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Erzeugt genau eine veroeffentlichbare JAR: target/MHCenter2-1.0.0.jar -->
    <finalName>MHCenter2-${project.version}</finalName>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>${project.build.sourceEncoding}</encoding>

          <!--
            Java 21+ fuehrt Annotation Processing nur noch aus, wenn es ausdruecklich
            aktiviert wird. "full" entspricht javac -proc:full und ist unter Java 25
            zwingend, damit der Velocity Annotation Processor wirklich laeuft.
          -->
          <proc>full</proc>

          <!--
            Der Processor liegt ausschliesslich auf dem Processor-Pfad und damit
            weder auf dem Compile-Classpath noch in der fertigen JAR.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>com.velocitypowered</groupId>
              <artifactId>velocity-api</artifactId>
              <version>${velocity.api.version}</version>
            </path>
          </annotationProcessorPaths>

          <!--
            Ausdrueckliche Auswahl des Velocity Processors, der beim Build
            target/classes/velocity-plugin.json aus der @Plugin-Annotation erzeugt.
          -->
          <annotationProcessors>
            <annotationProcessor>com.velocitypowered.api.plugin.ap.PluginAnnotationProcessor</annotationProcessor>
          </annotationProcessors>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
      </plugin>

      <!--
        Minimales Shading: Es werden ausschliesslich die beiden JDBC-Treiber
        eingebettet, SQLite fuer die lokale Datenbank und MariaDB fuer die
        optionale Remote-Datenbank. Kein Relocation, kein minimizeJar, keine
        weiteren Artefakte. Paper API und Velocity API sind "provided" und werden
        von Shade nie beruecksichtigt.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.plugin.version}</version>
        <executions>
          <execution>
            <id>shade-jdbc-drivers</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>org.xerial:sqlite-jdbc</include>
                  <include>org.mariadb.jdbc:mariadb-java-client</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>org.xerial:sqlite-jdbc</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.mariadb.jdbc:mariadb-java-client</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/versions/**</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- Haelt META-INF/services/java.sql.Driver und die Treiber-Plugins intakt. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
